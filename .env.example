# Copy to .env.local (gitignored) and fill in. `/setup` in Claude Code does this for you.

# Neon Postgres connection string (pooled)
DATABASE_URL=

# Financy / Open Finance API (Settings → API in the Financy app). Not needed for the demo.
FINANCY_CLIENT_ID=
FINANCY_CLIENT_SECRET=
FINANCY_USER_ID=

# Shared household password for logging in: 12+ characters (not needed in demo mode)
HOUSEHOLD_PASSWORD=

# Random secrets: `openssl rand -hex 32`
SESSION_SECRET=
CRON_SECRET=

# Demo mode: fake data, no login, no Financy. DEMO_DATABASE_URL must point at a database named balance_demo.
DEMO_MODE=
DEMO_DATABASE_URL=
